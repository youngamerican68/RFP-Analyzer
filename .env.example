# LLM API Configuration
# =====================
# Replace with your actual LLM API key
# For Anthropic Claude: Get your key from https://console.anthropic.com/
# For OpenAI: Get your key from https://platform.openai.com/api-keys

LLM_API_KEY=your_llm_api_key_here

# To use this file:
# 1. Copy this file to .env.local: cp .env.example .env.local
# 2. Replace the placeholder value with your actual API key
# 3. Never commit .env.local to version control (it's in .gitignore)

# For Vercel deployment:
# 1. Go to your project settings
# 2. Navigate to Environment Variables
# 3. Add LLM_API_KEY with your actual key
# 4. Select Production, Preview, and Development environments

# For Forge App (AI PR Risk Summary):
# Set environment variables using Forge CLI:
# forge variables set LLM_API_KEY your_key_here
# forge variables set LLM_PROVIDER anthropic  # or 'openai'
